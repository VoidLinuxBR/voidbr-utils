#!/usr/bin/env bash

set -e

# -----------------------------------------------------------------------------
# voidbr-copy-skel
# Copia /etc/skel para o HOME preservando os arquivos substituídos em backup.
#
# Opções:
#   --user USUARIO   Copia para o HOME do usuário informado (requer root)
#   --force          Não pede confirmação antes de copiar
# -----------------------------------------------------------------------------

skel="/etc/skel"
target_user=""
force=0
quiet=0

# -----------------------------------------------------------------------------
# Cores
# -----------------------------------------------------------------------------

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    reset="$(tput sgr0)"
    bold="$(tput bold)"
    dim="$(tput dim)"

    red="$(tput setaf 1)"
    green="$(tput setaf 2)"
    yellow="$(tput setaf 3)"
    blue="$(tput setaf 4)"
    magenta="$(tput setaf 5)"
    cyan="$(tput setaf 6)"
    white="$(tput setaf 7)"
else
    reset=""
    bold=""
    dim=""

    red=""
    green=""
    yellow=""
    blue=""
    magenta=""
    cyan=""
    white=""
fi

# -----------------------------------------------------------------------------
# Usage
# -----------------------------------------------------------------------------

usage() {
    cat <<EOF

${bold}${cyan}voidbr-copy-skel${reset}

${white}Uso:${reset}
  ${green}$(basename "$0")${reset} ${dim}[OPÇÕES]${reset}

${white}Descrição:${reset}
  Copia todo o conteúdo de:

    ${cyan}$skel${reset}

  para o HOME do usuário atual (ou de outro usuário, com ${green}--user${reset}).

  Antes da cópia, todos os arquivos existentes que seriam
  substituídos são preservados em um diretório de backup.

${white}Backup:${reset}
  ${magenta}<HOME>/.voidbr-skel-backup-AAAAMMDD-HHMMSS/${reset}

${yellow}${bold}ATENÇÃO:${reset}
  Arquivos existentes no HOME com o mesmo nome dos arquivos
  encontrados em ${cyan}$skel${reset} serão ${red}${bold}SUBSTITUÍDOS${reset}.

${white}Opções:${reset}
  ${green}--user USUARIO${reset}   Copia para o HOME do USUARIO informado.
                    ${dim}Requer que o script seja executado como root.${reset}
  ${green}--force${reset}          Não pede confirmação antes de copiar.
  ${green}-q, --quiet${reset}      Não exibe nada, exceto erros. Implica --force.
  ${green}-h, --help${reset}       Exibe esta ajuda.

${white}Exemplos:${reset}
  ${green}$(basename "$0")${reset}
  ${green}sudo $(basename "$0") --user joao${reset}
  ${green}$(basename "$0") --force${reset}
  ${green}$(basename "$0") --quiet${reset}

EOF
}

# -----------------------------------------------------------------------------
# Confirmação
# -----------------------------------------------------------------------------

confirm() {
    local answer

    if (( force == 1 )); then
        return 0
    fi

    echo
    printf '%s\n' "${yellow}${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}"
    printf '%s\n' "${yellow}${bold}  ⚠  ATENÇÃO${reset}"
    printf '%s\n' "${yellow}${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}"
    echo

    printf '  %sOrigem :%s %s\n' "$white" "$reset" "${cyan}$skel${reset}"
    printf '  %sDestino:%s %s\n' "$white" "$reset" "${cyan}$dest${reset}"
    printf '  %sBackup :%s %s\n' "$white" "$reset" "${magenta}$backup${reset}"

    echo
    printf '  Arquivos existentes serão %s%sSUBSTITUÍDOS%s após o backup.\n' \
        "$red" "$bold" "$reset"
    echo

    printf '%sDeseja continuar? %s[s/N]%s: ' "$bold" "$yellow" "$reset"
    read -r answer

    case "$answer" in
        s|S|sim|Sim|SIM)
            ;;
        *)
            echo
            printf '%s●%s Operação cancelada.\n\n' "$yellow" "$reset"
            exit 0
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------

backup_files() {
    local src
    local rel
    local dst
    local count=0

    echo
    printf '%s◆%s %sVerificando arquivos existentes...%s\n' \
        "$cyan" "$reset" "$bold" "$reset"
    echo

    while IFS= read -r -d '' src; do
        rel="${src#"$skel"/}"
        dst="$dest/$rel"

        if [[ -e "$dst" || -L "$dst" ]]; then
            mkdir -p "$backup/$(dirname "$rel")"

            printf '  %s↳%s %-8s %s%s%s\n' \
                "$magenta" "$reset" \
                "backup" "$dim" "$rel" "$reset"

            cp -pa "$dst" "$backup/$rel"

            ((count++)) || true
        fi
    done < <(find "$skel" \( -type f -o -type l \) -print0)

    echo

    if (( count > 0 )); then
        printf '%s✓%s %s%d arquivo(s) preservado(s) no backup.%s\n' \
            "$green" "$reset" "$bold" "$count" "$reset"

        printf '  %s%s%s\n' "$magenta" "$backup" "$reset"
    else
        printf '%s✓%s Nenhum arquivo existente precisa de backup.\n' \
            "$green" "$reset"
    fi
}

# -----------------------------------------------------------------------------
# Ajusta dono dos arquivos copiados (somente com --user)
# -----------------------------------------------------------------------------

fix_ownership() {
    local item
    local rel
    local errors=0

    printf '%s◆%s %sAjustando dono dos arquivos para %s%s...%s\n' \
        "$cyan" "$reset" "$bold" "$target_user" "$bold" "$reset"

    shopt -s dotglob nullglob
    for item in "$skel"/*; do
        rel="$(basename "$item")"

        if ! chown -R "$target_uid:$target_gid" "$dest/$rel"; then
            printf '  %s✗%s falha ao ajustar dono de: %s\n' \
                "$red" "$reset" "$dest/$rel" >&2
            ((errors++)) || true
        fi
    done
    shopt -u dotglob nullglob

    if [[ -d "$backup" ]]; then
        if ! chown -R "$target_uid:$target_gid" "$backup"; then
            printf '  %s✗%s falha ao ajustar dono de: %s\n' \
                "$red" "$reset" "$backup" >&2
            ((errors++)) || true
        fi
    fi

    if (( errors > 0 )); then
        printf '%s✗ ERRO:%s %d item(ns) continuaram pertencendo a %s%s%s.\n' \
            "${red}${bold}" "$reset" "$errors" "$bold" "$(id -un)" "$reset" >&2
        printf 'Corrija manualmente: %ssudo chown -R %s:%s %s%s\n' \
            "$green" "$target_uid" "$target_gid" "$dest" "$reset" >&2
        exit 1
    fi

    printf '%s✓%s Dono ajustado.\n' "$green" "$reset"
}

# -----------------------------------------------------------------------------
# Argumentos
# -----------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        --user)
            if [[ -z "${2:-}" ]]; then
                echo
                printf '%s✗ ERRO:%s --user requer um nome de usuário.\n' \
                    "${red}${bold}" "$reset" >&2
                exit 1
            fi
            target_user="$2"
            shift 2
            ;;

        --force)
            force=1
            shift
            ;;

        -q|--quiet)
            quiet=1
            shift
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        *)
            echo
            printf '%s✗ ERRO:%s opção inválida: %s\n' \
                "${red}${bold}" "$reset" "$1" >&2
            usage
            exit 1
            ;;
    esac
done

# -----------------------------------------------------------------------------
# Modo silencioso
#
# Suprime toda a saída normal (stdout). Mensagens de erro continuam
# visíveis, pois são escritas em stderr. --quiet implica --force,
# já que não há como exibir a pergunta de confirmação.
# -----------------------------------------------------------------------------

if (( quiet == 1 )); then
    force=1
    exec 1>/dev/null
fi

# -----------------------------------------------------------------------------
# Resolução de destino / validação de usuário root
# -----------------------------------------------------------------------------

if [[ -n "$target_user" ]]; then
    if (( EUID != 0 )); then
        printf '%s✗ ERRO:%s --user requer que o script seja executado como root.\n' \
            "${red}${bold}" "$reset" >&2
        printf 'Execute com: %ssudo %s --user %s%s\n' \
            "$green" "$(basename "$0")" "$target_user" "$reset" >&2
        exit 1
    fi

    if ! id "$target_user" >/dev/null 2>&1; then
        printf '%s✗ ERRO:%s usuário não encontrado: %s\n' \
            "${red}${bold}" "$reset" "$target_user" >&2
        exit 1
    fi

    dest="$(getent passwd "$target_user" | cut -d: -f6)"
    target_uid="$(id -u "$target_user")"
    target_gid="$(id -g "$target_user")"

    if [[ -z "$dest" ]]; then
        printf '%s✗ ERRO:%s não foi possível determinar o HOME de %s\n' \
            "${red}${bold}" "$reset" "$target_user" >&2
        exit 1
    fi
else
    if (( EUID == 0 )); then
        printf '%s✗ ERRO:%s este programa não pode ser executado como root.\n' \
            "${red}${bold}" "$reset" >&2
        printf 'Execute como usuário normal: %s%s%s\n' \
            "$green" "$(basename "$0")" "$reset" >&2
        printf 'Ou use %s%s --user USUARIO%s para copiar para outro usuário.\n' \
            "$green" "$(basename "$0")" "$reset" >&2
        exit 1
    fi

    dest="${HOME:?HOME não definido}"
fi

backup="$dest/.voidbr-skel-backup-$(date +%Y%m%d-%H%M%S)"

# -----------------------------------------------------------------------------
# Validações
# -----------------------------------------------------------------------------

if [[ ! -d "$skel" ]]; then
    printf '%s✗ ERRO:%s diretório não encontrado: %s\n' \
        "${red}${bold}" "$reset" "$skel" >&2
    exit 1
fi

if [[ ! -d "$dest" ]]; then
    printf '%s✗ ERRO:%s HOME não encontrado: %s\n' \
        "${red}${bold}" "$reset" "$dest" >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# Confirmação
# -----------------------------------------------------------------------------

confirm

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------

backup_files

# -----------------------------------------------------------------------------
# Cópia
# -----------------------------------------------------------------------------

echo
printf '%s◆%s %sCopiando configurações do VoidBR...%s\n' \
    "$cyan" "$reset" "$bold" "$reset"
echo

printf '  %s%s%s\n' "$dim" "$skel → $dest" "$reset"
echo

cp -Rvpa "$skel"/. "$dest"/

# -----------------------------------------------------------------------------
# Ajuste de dono (somente com --user)
# -----------------------------------------------------------------------------

if [[ -n "$target_user" ]]; then
    echo
    fix_ownership
fi

# -----------------------------------------------------------------------------
# Finalização
# -----------------------------------------------------------------------------

echo
printf '%s%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
    "$green" "$bold" "$reset"

printf '%s✓ Cópia concluída com sucesso.%s\n' \
    "${green}${bold}" "$reset"

printf '%s%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' \
    "$green" "$bold" "$reset"

if [[ -d "$backup" ]]; then
    echo
    printf '%sBackup:%s\n' "$white" "$reset"
    printf '  %s%s%s\n' "$magenta" "$backup" "$reset"
fi
