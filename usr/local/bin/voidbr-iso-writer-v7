#!/usr/bin/env python3
"""
ISO Writer - Grava uma imagem ISO em um pendrive (dispositivo USB)
Requer: PyGObject (GTK4), pkexec (polkit) e dd instalados no sistema.

Instalação típica no Void Linux:
    sudo xbps-install -S python3-gobject gtk4 polkit

Execução:
    python3 iso_writer.py
"""

import gi
import subprocess
import threading
import os

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib, Gio

