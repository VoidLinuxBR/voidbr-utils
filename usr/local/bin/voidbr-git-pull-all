export LANGUAGE="${LANGUAGE:-pt_BR}"
export TEXTDOMAINDIR=/usr/share/locale
export TEXTDOMAIN=voidbr-git-pull-all

#debug
export PS4='${red}${0##*/}${green}[$FUNCNAME]${pink}[$LINENO]${reset}'
#set -x
#set -e
#set -euo pipefail
shopt -s extglob

#system
declare APP="${0##*/}"
declare _VERSION_="0.07.31-20260731"
declare APPDESC="$APP - Wraper for "
declare -A PACKAGEDEP=(
	[gettext]=gettext
	[git]=git
	[tput]=ncurses
)
# Mapa: [distro]="lista de pacotes"
declare -A DISTRO_PKGS=(
	["voidbr"]="gettext git ncurses"
	["void"]="gettext git ncurses"
	["void-live"]="gettext git ncurses"
	["voidlinux"]="gettext git ncurses"
	["chili"]="gettext git ncurses"
	["chililinux"]="gettext git ncurses"
	["arch"]="gettext git ncurses"
	["manjaro"]="gettext git ncurses"
	["biglinux"]="gettext git ncurses"
	["debian"]="gettext git ncurses"
)
# Mapa: [distro]="comando de instalação"
declare -A DISTRO_MGR=(
	["voidbr"]="xbps-install -Syf"
	["void"]="xbps-install -Syf"
	["void-live"]="xbps-install -Syf"
	["voidlinux"]="xbps-install -Syf"
	["chili"]="pacman -Sy --needed --noconfirm"
	["chililinux"]="pacman -Sy --needed --noconfirm"
	["arch"]="pacman -Sy --needed --noconfirm"
	["manjaro"]="pacman -Sy --needed --noconfirm"
	["biglinux"]="pacman -Sy --needed --noconfirm"
	["debian"]="apt-get install -y"
)

has_command() {
  command -v "$1" >/dev/null && return 0 || return 1
}

set_varcolors() {
	# does the terminal support true-color?
	if has_command tput; then
		#tput setaf 127 | cat -v  #capturar saida
		: "${RED=$(tput bold)$(tput setaf 196)}"
		: "${GREEN=$(tput bold)$(tput setaf 2)}"
		: "${YELLOW=$(tput bold)$(tput setaf 3)}"
		: "${BLUE=$(tput setaf 4)}"
		: "${PURPLE=$(tput setaf 125)}"
		: "${CYAN=$(tput setaf 6)}"
		: "${NC=$(tput sgr0)}"
		: "${RESET=$(tput sgr0)}"
		: "${BOLD=$(tput bold)}"
		: "${black=$(tput bold)$(tput setaf 0)}"
		: "${reverse=$(tput rev)}"
		: "${branca=${black}$(tput setab 7)}"

		: "${reset=$(tput sgr0)}"
		: "${rst=$(tput sgr0)}"
		: "${bold=$(tput bold)}"
		: "${underline=$(tput smul)}"
		: "${nounderline=$(tput rmul)}"
		: "${reverse=$(tput rev)}"

		: "${black=$(tput bold)$(tput setaf 0)}"
		: "${red=$(tput bold)$(tput setaf 196)}"
		: "${green=$(tput bold)$(tput setaf 2)}"
		: "${yellow=$(tput bold)$(tput setaf 3)}"
		: "${blue=$(tput setaf 27)}"
		: "${pink=$(tput setaf 5)}"
		: "${magenta=$(tput setaf 5)}"
		: "${cyan=$(tput setaf 6)}"
		: "${white=$(tput setaf 7)}"
		: "${gray=$(tput setaf 8)}"
		: "${light_red=$(tput setaf 9)}"
		: "${light_green=$(tput setaf 10)}"
		: "${light_yellow=$(tput setaf 11)}"
		: "${light_blue=$(tput setaf 12)}"
		: "${light_magenta=$(tput setaf 13)}"
		: "${light_cyan=$(tput setaf 14)}"
		: "${light_white=$(tput setaf 15)}"
		: "${orange=$(tput setaf 202)}"
		: "${purple=$(tput setaf 125)}"
		: "${violet=$(tput setaf 61)}"

		# Definir cores de fundo
		: "${preto=$(tput setab 0)}"
		: "${vermelho=$(tput setab 196)}"
		: "${verde=$(tput setab 2)}"
		: "${amarelo=$(tput setab 3)}"
		: "${azul=$(tput setab 20)}"
		: "${roxo=$(tput setab 5)}"
		: "${ciano=$(tput setab 6)}"
		: "${branca="${black}$(tput setab 7)"}"
		: "${cinza=$(tput setab 8)}"
		: "${laranja=$(tput setab 202)}"
		: "${roxa=$(tput setab 125)}"
		: "${violeta=$(tput setab 61)}"

		: "${COL_NC='\e[0m'}" # No Color
		: "${COL_LIGHT_GREEN='\e[1;32m'}"
		: "${COL_LIGHT_RED='\e[1;31m'}"
		: "${DONE="${COL_LIGHT_GREEN} done!${COL_NC}"}"
		: "${OVER="\\r\\033[K"}"
		: "${DOTPREFIX="  ${black}::${reset} "}"
		: "${clrkey=${light_white}}"
		: "${TICK="${clrkey}[${green}✓${clrkey}]${rst}"}"
		: "${CROSS="${clrkey}[${red}✗${clrkey}]${rst}"}"
		: "${MID="${clrkey}[${red}✗${green}✓${clrkey}]${rst}"}"
		: "${WARN="${clrkey}[${yellow}⚠${clrkey}]${yellow}"}"
#		: "${INFO="${cyan}[➜]${rst}"}"
		: "${INFO="${cyan}[⛭]${rst}"}"

		# dialog colors
		REVERSE="\Zr"
		UNDERLINE="\Zu"
		BOLD="\Zb"
		RESET="\Zn"
		BLACK="\Z0"
		YELLOW="\Z3"
		AMARELO="\Zb\Z3"
		WHITE="\Z7"
		BLUE="\Z4"
		AZUL="\Zb\Z4"
		CYAN="\Z6"
		RED="\Z1"
		GREEN="\Z2"
		MAGENTA="\Z5"
	else
		unset_varcolors
	fi
}

unset_varcolors() {
	unset RED GREEN YELLOW BLUE PURPLE CYAN NC RESET BOLD
	unset reset rst bold underline nounderline reverse
	unset black red green yellow blue magenta cyan white gray orange purple violet
	unset light_red light_green light_yellow light_blue light_magenta light_cyan light_white
	unset preto vermelho verde amarelo azul roxo ciano branca cinza laranja roxa violeta
	TICK="${white}[${verde}✓${rst}${white}]${rst}"
	CROSS="${white}[${roxa}✗${rst}${white}]${rst}"
	INFO="${white}[${cinza}i${rst}${white}]${rst}"
}

sh_checkroot() {
	((EUID != 0)) && elevate_to_root "$@" || return 0
}

elevate_to_root() {
	log_err "This script must be run as root. Elevating privileges..."
	ccabec+='root [elevated]'
	# Tenta usar sudo primeiro (caso esteja configurado)
	if has_command sudo; then
		exec sudo bash "$0" "$@"
	fi
	# Se sudo falhar, tenta su
	if has_command su; then
		exec su -c "$0 $*"
	fi
	die "Error: Unable to elevate privileges. Run manually as root."
}

replicate() {
	local char="${1:-#}"
	local nsize="${2:-$(tput cols)}"
	# Gera linha com substituição direta sem forks extras
	printf -v _line "%*s" "$nsize" && printf '%b\n' "${blue}${_line// /$char}${reset}"
}

readconf() {
	local msg="$1"
	local color="${2:-${yellow}}"

	echo -n -e "$color"
	if [[ $LC_DEFAULT -eq 0 ]]; then
		read -r -p "$msg [N/s] :"
	else
		read -r -p "$msg [N/y] :"
	fi
	echo -n -e "$reset"
	case "${REPLY^}" in
	[SY]) return 0 ;;
	"") return 1 ;;
	*) return 1 ;;
	esac
}

debug() {
	# dialog
	whiptail --fb --clear --backtitle "[debug]$0" --title "[debug]$0" --yesno "${*}\n" 0 40
	local result="$?"
	((result)) && exit "$result"
	return "$result"
}

# ===================================================================
# Funções auxiliares
# ===================================================================
run_cmd() {
	local cmd="$*"

	if [[ $DRYRUN -eq 1 ]]; then
		msg "${cyan}[DRY-RUN]${rst} ${cmd}"
	else
		echo -e "  [⚙  ] ${cyan}${cmd}${rst}"
		# Executa o comando, falha se houver erro
		# Redireciona stderr para /dev/null apenas para mkdir -p e ummount -R
		if [[ "$cmd" =~ ^mkdir\ -p ]] || [[ "$cmd" =~ ^umount\ -R ]]; then
			eval "$cmd" &>/dev/null || true
		else
			eval "$cmd" || log_warn_tab "Falha ao executar: $cmd"
		fi
	fi
}

sh_copyright() {
  cat <<EOF-COPY
${bold}${cyan}${0##*/} v${_VERSION_}${rst}
${bold}${cyan}${APPDESC}${rst}
${bold}${orange}Copyright (c) 2019-2026, ${reset}ChiliLinux Development Team <https://github.com/chililinux>
${bold}${orange}Copyright (c) 2019-2026, ${reset}Vilmar Catafesta <vcatafesta@gmail.com>${black}
EOF-COPY
}

sh_version() {
  cat <<-EOF-VERSION
  $(sh_copyright)

  $(gettext 'Este é um software livre: você é livre para alterá-lo e redistribuí-lo.')
  $(gettext 'O $APP é disponibilizado para você sob a ${yellow}Licença MIT${black}, e')
  $(gettext 'inclui software de código aberto sob uma variedade de outras licenças.')
  $(gettext 'Você pode ler instruções sobre como baixar e criar para você mesmo')
  $(gettext 'o código fonte específico usado para criar esta cópia.')
  ${red}$(gettext 'Este programa vem com absolutamente NENHUMA garantia.')${reset}
EOF-VERSION
}

msg() { echo -e "${INFO} ${*}${reset}"; }
log_ok() { echo -e "${TICK} ${*}${reset}"; }
log_err() { echo -e "${CROSS} ${*}${reset}"; }
log_mid() { echo -e "${MID} ${*}${reset}"; }
log_warn() { echo -e "${WARN} ${*}${reset}"; }
msg_tab() { echo -e "  ${INFO} ${*}${reset}"; }
log_ok_tab() { echo -e "  ${TICK} ${*}${reset}"; }
log_err_tab() { echo -e "  ${CROSS} ${*}${reset}"; }
log_mid_tab() { echo -e "  ${MID} ${*}${reset}"; }
log_warn_tab() { echo -e "  ${WARN} ${*}${reset}"; }
die() {
	echo -e "${CROSS} ${red}${*}${reset}"
	exit 1
}

detect_distro() {
	local id=""

	if [[ -r /etc/os-release ]]; then
		# Lê ID=void|arch|debian|... exatamente como a distro declara
		id=$(grep -E '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')
	elif [[ -r /usr/lib/os-release ]]; then
		id=$(grep -E '^ID=' /usr/lib/os-release | cut -d= -f2 | tr -d '"')
	else
		echo "unknown"
		return
	fi
	echo "$id"
}

sh_checkDependencies() {
	local DISTRO="$(detect_distro)"
	local aBlock_files=()
	local d
	local pkg
	local errorFound=false
	declare -a missing
	local cmsgNot="$(gettext "Não foi possível encontrar o comando")"
	local cmsgPkg="$(gettext "instalar pacote")"

	for d in "${!PACKAGEDEP[@]}"; do
		if ! has_command "$d"; then
			pkg="${PACKAGEDEP[$d]}"
			log_err "${red}Error${rst}: ${cmsgNot} $(printf "${cyan}%-15s${rst}\n" "$d") -> ${cmsgPkg} ${cyan}${pkg}${rst}"
			missing+=("${pkg}")
			errorFound=true
		else
			#log_msg "Check: ${cyan}$d"
			:
		fi
	done

	if $errorFound; then
		replicate '='
		echo "${yellow}             $(gettext "IMPOSSÍVEL CONTINUAR")"
		echo "${black}$(gettext "Este script precisa dos comandos listados acima")"
		echo "${black}$(gettext "Instale-os e/ou verifique se eles estão em seu") ${red}\$PATH${reset}"
		replicate '='

		local cmd="${DISTRO_MGR[$DISTRO]}"
		#local pkgs="${DISTRO_PKGS[$DISTRO]}"
		local pkgs="${missing[@]}"

		msg_tab "Distro detectada: ${cyan}$DISTRO${rst}"
		if readconf "$(gettext "Instalar dependências base agora?")"; then
			echo -e "${blue}::${rst} $(gettext "Preparando ambiente para") ${green}${DISTRO}${reset}..."
			# Execução dinâmica: $cmd (gerenciador) + $pkgs (lista de pacotes)
			if ! $cmd $pkgs; then
				echo
				echo -e "${red}$(gettext "Erro Crítico:")${rst} $(gettext "A instalação dos pacotes básicos falhou.")"
				exit 1
			fi
			echo
			echo -e "${green}$(gettext "Sucesso:")${reset} $(gettext "Dependências instaladas.")"
		fi
	fi
}

# configure ambiente
set_varcolors
#sh_checkroot "$@"

##########################################################################################################

#
# Parse de argumentos: -h/--help mostra o usage e sai.
# Os demais argumentos (se houver) são tratados como lista explícita de repositórios.
#
usage() {
	cat <<-USAGE
		${bold}${cyan}Uso:${reset} ${APP} [opções] [repositório ...]

		Atualiza (git pull) todos os subdiretórios git do diretório atual,
		ou apenas os repositórios passados explicitamente como argumento.

		Cada repositório é verificado via 'git fetch' antes de qualquer merge:
		só é mesclado de fato se estiver realmente desatualizado em relação ao remoto.

		${yellow}Opções:${reset}
		  ${green}-h, --help${reset}     Mostra esta ajuda e sai
		  ${green}-V, --version${reset}     Mostra versão do applicativo

		${yellow}Variáveis de ambiente:${reset}
		  ${green}JOBS=N${reset}           Quantidade de repositórios processados em paralelo.
		                   Padrão: 4. Use JOBS=1 para sequencial.
		  ${green}PULL_TIMEOUT=N${reset}   Timeout em segundos para cada 'git fetch'/'git merge'.
		                   Padrão: 60.

		${yellow}Exemplos:${reset}
		  ${cyan}${APP}${reset}                       # processa todos os repositórios da pasta atual
		  ${cyan}${APP} repo1 repo2${reset}           # processa só repo1 e repo2
		  ${cyan}JOBS=8 ${APP}${reset}                # roda com 8 processos em paralelo
		  ${cyan}PULL_TIMEOUT=120 ${APP}${reset}      # timeout de 120s por repositório
	USAGE
}

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	-V | --version)
		sh_version
		exit 0
		;;
	esac
done

getbranch() {
	if git rev-parse --verify origin/main >/dev/null 2>&1; then
		branch='main'
	elif git rev-parse --verify origin/master >/dev/null 2>&1; then
		branch='master'
	else
		branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
	fi

	if git remote | grep -qx upstream; then
		remote=upstream
	else
		remote=origin
	fi

	[[ -n "$branch" ]]
}

#
# Lista completa de repositórios. Sempre processa todos —
# quem já está em dia é detectado pelo fetch+compare em process_repo,
# sem custo real de merge.
#
all_repos=()

if (($# > 0)); then
	all_repos=("$@")
else
	while IFS= read -r dir; do
		all_repos+=("$dir")
	done < <(
		find . \
			-mindepth 1 \
			-maxdepth 1 \
			-type d \
			-printf '%f\n' |
			sort
	)
fi

total=${#all_repos[@]}

((total)) || {
	printf "${yellow}Nenhum repositório encontrado.${reset}\n"
	exit 0
}

repos=("${all_repos[@]}")

updated=0
current=0
ignored=0
failed=0
dirty=0

failed_repos=()
dirty_repos=()

# Número de repositórios processados em paralelo.
# JOBS=1 (padrão) preserva o comportamento sequencial original.
JOBS="${JOBS:-4}"

msg "Atualizando ${total} repositórios (JOBS=${JOBS})"
printf "\n"

resultdir="$(mktemp -d "/tmp/${APP}-results.XXXXXX")"
trap 'rm -rf "$resultdir"' EXIT

#
# Processa um único repositório.
# Escreve toda a saída formatada em $resultfile, e o status
# ("UPDATED"/"CURRENT"/"IGNORED"/"FAILED") + nome do repo em ${resultfile}.status,
# para permitir agregação segura depois que os jobs paralelos terminarem.
#
process_repo() {
	local repo="$1"
	local idx="$2"
	local resultfile="$3"

	{
		printf "${cyan}[%2d/%2d]${reset} %-45s" "$idx" "$total" "$repo"

		if [[ ! -d "$repo/.git" ]]; then
			printf "${yellow}[IGNORADO]${reset}\n"
			printf 'IGNORED\n%s\n' "$repo" >"${resultfile}.status"
			return
		fi

		local output
		output="$(
			(
				cd "$repo" || exit 1

				#
				# Não mexe em repositório com alterações locais não commitadas.
				# Evita sobrescrever/misturar trabalho em andamento com o pull.
				#
				dirty_status="$(git status --porcelain --untracked-files=no 2>/dev/null)"
				if [[ -n "$dirty_status" ]]; then
					echo "__REPO_SUJO__"
					git status
					exit 1
				fi

				getbranch || exit 1

				git checkout "$branch" >/dev/null 2>&1 || exit 1

				before="$(git rev-parse HEAD)" || exit 1

				#
				# Busca as referências do remoto sem tocar na working tree.
				# Permite verificar se o local está desatualizado ANTES de
				# tentar qualquer merge.
				#
				timeout "${PULL_TIMEOUT:-60}" git fetch "$remote" "$branch"
				fetch_status=$?

				if ((fetch_status == 124)); then
					echo "Timeout: git fetch excedeu ${PULL_TIMEOUT:-60}s"
					exit 124
				elif ((fetch_status != 0)); then
					exit "$fetch_status"
				fi

				remote_head="$(git rev-parse FETCH_HEAD)" || exit 1

				if [[ "$before" == "$remote_head" ]]; then
					#
					# Já está atualizado — nem tenta merge.
					#
					printf '__PULL_CURRENT__\n'
					exit 0
				fi

				#
				# Existe algo novo no remoto (ou divergência): mescla de fato.
				#
				git merge --no-ff "$remote_head"
				pull_status=$?

				after="$(git rev-parse HEAD)"

				if ((pull_status == 0)) && [[ "$before" == "$after" ]]; then
					printf '__PULL_CURRENT__\n'
				fi

				exit "$pull_status"
			) 2>&1
		)"

		local status=$?

		if grep -q '__REPO_SUJO__' <<<"$output"; then
			printf "${yellow}[SUJO]${reset}\n"
			printf '%s\n' "$output" | grep -v '__REPO_SUJO__'
			printf 'DIRTY\n%s\n' "$repo" >"${resultfile}.status"
			return
		fi

		if ((status == 0)); then
			if grep -qx '__PULL_CURRENT__' <<<"$output"; then
				printf "${cyan}[CURRENT]${reset}\n"
				printf 'CURRENT\n%s\n' "$repo" >"${resultfile}.status"
			else
				printf "${green}[UPDATED]${reset}\n"
				printf 'UPDATED\n%s\n' "$repo" >"${resultfile}.status"
			fi
		else
			printf "${red}[FALHOU]${reset}\n"
			printf "%s\n" "$output"
			printf 'FAILED\n%s\n' "$repo" >"${resultfile}.status"
		fi
	} >"$resultfile" 2>&1
}

idx=0
next_to_print=1

#
# Imprime na ordem original os resultados já concluídos.
# Chamada depois de cada job terminar, permite acompanhar o progresso
# em tempo real em vez de só ver tudo no final.
#
print_ready_results() {
	while ((next_to_print <= idx)); do
		local rf
		rf="$resultdir/$(printf '%05d' "$next_to_print")"

		[[ -f "${rf}.status" ]] || break

		cat "$rf"

		local word repo_name
		{
			read -r word
			read -r repo_name
		} <"${rf}.status" 2>/dev/null

		case "$word" in
		UPDATED) updated=$((updated + 1)) ;;
		CURRENT) current=$((current + 1)) ;;
		IGNORED) ignored=$((ignored + 1)) ;;
		DIRTY)
			dirty=$((dirty + 1))
			dirty_repos+=("$repo_name")
			;;
		FAILED)
			failed=$((failed + 1))
			failed_repos+=("$repo_name")
			;;
		esac

		next_to_print=$((next_to_print + 1))
	done
}

running=0

for repo in "${repos[@]}"; do
	idx=$((idx + 1))
	resultfile="$resultdir/$(printf '%05d' "$idx")"

	process_repo "$repo" "$idx" "$resultfile" &

	running=$((running + 1))
	if ((running >= JOBS)); then
		wait -n
		running=$((running - 1))
		print_ready_results
	fi
done

wait
print_ready_results

printf "\n"
printf "${bold}──────────────────────────────────────────────────────────────${reset}\n"
printf " Total         : %d\n" "$total"
printf " ${green}Updated${reset}       : %d\n" "$updated"
printf " ${cyan}Current${reset}       : %d\n" "$current"
printf " ${yellow}Ignorados${reset}     : %d\n" "$ignored"
printf " ${yellow}Sujos${reset}         : %d\n" "$dirty"
printf " ${red}Falhas${reset}        : %d\n" "$failed"
printf "${bold}──────────────────────────────────────────────────────────────${reset}\n"

if ((dirty > 0)); then
	printf "\n"
	printf "${yellow}${bold}Repositórios com alterações locais não commitadas (pulados):${reset}\n\n"

	for repo in "${dirty_repos[@]}"; do
		printf "  ${yellow}•${reset} %s\n" "$repo"
	done
	printf "\n"
fi

if ((failed > 0)); then
	printf "\n"
	printf "${red}${bold}Repositórios com falha:${reset}\n\n"

	for repo in "${failed_repos[@]}"; do
		printf "  ${red}•${reset} %s\n" "$repo"
	done
	printf "\n"
fi

exit "$failed"
