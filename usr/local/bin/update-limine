#!/bin/sh

echo "Gerando o arquivo de configuração do limine..."

boot=/boot
#cfg="${boot}/limine.conf"
#boot_limine="/"
cfg="${boot}/efi/limine/limine.conf"
boot_limine="/limine"

root_uuid=$(findmnt -no UUID /)

[ -n "$root_uuid" ] || exit 1

set -- "$boot"/vmlinuz-*

[ -e "$1" ] || exit 0

for kernel in $(printf '%s\n' "$@" | sort -Vr); do
  version=${kernel##*/vmlinuz-}
  initramfs="${boot}/initramfs-${version}.img"

  [ -f "$initramfs" ] || continue
  echo "Imagem Linux encontrada: $kernel"
  cp -a /boot/$kernel /boot/efi/limine/
  echo "Imagem initrd encontrada: $initramfs"
  cp -a /boot/$initramfs /boot/efi/limine/
done

echo "Adicionando entradas de menu"
{
  echo '# VoidBR Limine theme'
  echo '# Author: Vilmar Catafesta <vcatafesta@gmail.com>'
  echo
  echo 'TIMEOUT: 3'
  echo 'VERBOSE: no'
  echo 'term_palette: 1e1e2e;f38ba8;a6e3a1;f9e2af;89b4fa;f5c2e7;94e2d5;cdd6f4'
  echo 'term_palette_bright: 585b70;f38ba8;a6e3a1;f9e2af;89e2b4;f5c2e7;94e2d5;cdd6f4'
  echo 'term_background: ffffffff'
  echo 'term_foreground: cdd6f4'
  echo 'term_background_bright: ffffffff'
  echo 'term_foreground_bright: cdd6f4'
  echo 'interface_branding:'
  echo 'wallpaper: boot():/limine/voidbr-tokyonight.png'
  echo 'wallpaper_style: stretched'
  echo

  for kernel in $(printf '%s\n' "$@" | sort -Vr); do
    version=${kernel##*/vmlinuz-}
    initramfs="${boot}/initramfs-${version}.img"

    [ -f "$initramfs" ] || continue

    printf '/VoidBR (Kernel %s)\n' "$version"
    printf '    PROTOCOL: linux\n'
    printf '    PATH: boot():%s/vmlinuz-%s\n' "$boot_limine" "$version"
    printf '    MODULE_PATH: boot():%s/initramfs-%s.img\n' "$boot_limine" "$version"
    printf '    CMDLINE: root=UUID=%s rw loglevel=4\n' "$root_uuid"
    printf '\n'

    printf '/VoidBR Recover Mode (Kernel %s)\n' "$version"
    printf '    PROTOCOL: linux\n'
    printf '    PATH: boot():%s/vmlinuz-%s\n' "$boot_limine" "$version"
    printf '    MODULE_PATH: boot():%s/initramfs-%s.img\n' "$boot_limine" "$version"
    printf '    CMDLINE: root=UUID=%s rw loglevel=4 single\n' "$root_uuid"
    printf '\n'
  done
} > "${cfg}.new"

mv "${cfg}.new" "$cfg"
