#!/bin/bash
# voidbr-change-wallpaper — compatível com Hyprland, Sway e Fluxbox/X11.
# Detecta o ambiente e usa o método certo pra trocar o wallpaper.

DIR="/usr/share/backgrounds/voidbr"
DEFAULT=""

if [[ -n "$1" ]]; then
	if [[ -f "$1" ]]; then
		DEFAULT="$1"
	elif [[ -f "$DIR/$1" ]]; then
		DEFAULT="$DIR/$1"
	fi
fi

mapfile -t imagens < <(
	find "$DIR" -type f \( \
		-iname "*.jpg" -o \
		-iname "*.jpeg" -o \
		-iname "*.png" -o \
		-iname "*.webp" -o \
		-iname "*.avif" -o \
		-iname "*.heic" \
		\)
)
((${#imagens[@]})) || exit 1

set_wallpaper() {
	local img="$1"
	if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
		hyprctl hyprpaper wallpaper ",$img"
	elif command -v swaybg >/dev/null && [[ -n "$WAYLAND_DISPLAY" ]]; then
		pkill -x swaybg 2>/dev/null
		swaybg -i "$img" -m fill &
	elif command -v feh >/dev/null && [[ -n "$DISPLAY" ]]; then
		feh --bg-fill "$img"
	else
		echo "voidbr-change-wallpaper: nenhum ambiente compatível encontrado" >&2
		exit 1
	fi
}

# Wallpaper inicial (opcional)
if [[ -n "$DEFAULT" ]]; then
	set_wallpaper "$DEFAULT"
fi

sleep 60
anterior=-1
while :; do
	if ((${#imagens[@]} > 1)); then
		while :; do
			indice=$((RANDOM % ${#imagens[@]}))
			((indice != anterior)) && break
		done
		anterior=$indice
	else
		indice=0
	fi
	img="${imagens[indice]}"
	set_wallpaper "$img"
	sleep 60
done
