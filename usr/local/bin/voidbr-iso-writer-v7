def listar_dispositivos_usb():
    """Retorna lista de dispositivos removíveis/USB via lsblk (formato JSON).

    Combina dois critérios (como no chili-iso2usb original):
    - RM=1 (removível) OU TRAN=usb (conectado via USB)
    Isso pega tanto pendrives quanto discos USB que às vezes não vêm
    marcados como removíveis pelo kernel.

    Também coleta as partições filhas (rótulo/sistema de arquivos), já
    que LABEL normalmente só existe nas partições, não no disco inteiro —
    isso alimenta o painel de "Propriedades do Dispositivo".
    """
    dispositivos = []
    try:
        saida = subprocess.run(
            ["lsblk", "-J", "-b", "-o", "NAME,SIZE,RM,TYPE,MODEL,TRAN,LABEL,FSTYPE"],
            capture_output=True, text=True, check=True
        ).stdout
        import json
        dados = json.loads(saida)
        for dev in dados.get("blockdevices", []):
            if dev.get("type") != "disk":
                continue
            removivel = dev.get("rm") in (True, "1", 1)
            usb = (dev.get("tran") or "").lower() == "usb"
            if not (removivel or usb):
                continue
            nome = f"/dev/{dev['name']}"
            tamanho_bytes = int(dev.get("size") or 0)
            tamanho_legivel = _formatar_tamanho(tamanho_bytes)
            modelo = (dev.get("model") or "Dispositivo").strip()
            transporte = (dev.get("tran") or "desconhecido").upper()

            particoes = []
            for filho in dev.get("children", []) or []:
                rotulo = (filho.get("label") or "").strip()
                fstype = (filho.get("fstype") or "").strip()
                nome_part = f"/dev/{filho['name']}"
                descricao_part = f"{nome_part}"
                if fstype:
                    descricao_part += f" ({fstype})"
                if rotulo:
                    descricao_part += f" — rótulo: {rotulo}"
                particoes.append(descricao_part)

            propriedades = {
                "modelo": modelo,
                "transporte": transporte,
                "tamanho": tamanho_legivel,
                "particoes": particoes,
            }

            dispositivos.append(
                (nome, f"{modelo} ({nome}, {tamanho_legivel})", tamanho_bytes, propriedades)
            )
    except Exception as e:
        print(f"Erro ao listar dispositivos: {e}")
    return dispositivos



def _formatar_tamanho(tamanho_bytes):
    """Converte bytes para uma string legível (GB/MB)."""
    if tamanho_bytes <= 0:
        return "?"
    gb = tamanho_bytes / (1024 ** 3)
    if gb >= 1:
        return f"{gb:.1f} GB"
    mb = tamanho_bytes / (1024 ** 2)
    return f"{mb:.0f} MB"


def pasta_inicial_iso():
    """Retorna a pasta Downloads do usuário real, ou o $HOME, para abrir o seletor."""
    usuario_real = os.environ.get("SUDO_USER") or os.environ.get("USER") or ""
    home = os.path.expanduser(f"~{usuario_real}") if usuario_real else os.path.expanduser("~")
    downloads = os.path.join(home, "Downloads")
    return downloads if os.path.isdir(downloads) else home


class JanelaISOWriter(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="voidbr-iso-writer")
        self.set_default_size(520, 420)

        self.caminho_iso = None
        self.dispositivo_alvo = None
        self.processo = None

        # --- CSS ---
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        # --- Barra de título com menu (☰ Sobre / Créditos) ---
        cabecalho = Gtk.HeaderBar()
        cabecalho.add_css_class("cabecalho-app")
        self.set_titlebar(cabecalho)

        menu_modelo = Gio.Menu()
        menu_modelo.append("ℹ️ Sobre / Créditos", "win.sobre")

        botao_menu = Gtk.MenuButton()
        botao_menu.set_icon_name("open-menu-symbolic")
        botao_menu.set_menu_model(menu_modelo)
        botao_menu.add_css_class("botao-menu")
        cabecalho.pack_end(botao_menu)

        acao_sobre = Gio.SimpleAction.new("sobre", None)
        acao_sobre.connect("activate", self.ao_clicar_sobre)
        self.add_action(acao_sobre)

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        caixa.set_margin_top(18)
        caixa.set_margin_bottom(18)
        caixa.set_margin_start(18)
        caixa.set_margin_end(18)
        self.set_child(caixa)

        # --- Título ---
        titulo = Gtk.Label(label="💿 voidbr-iso-writer")
        titulo.add_css_class("titulo-app")
        titulo.set_xalign(0)
        caixa.append(titulo)

        # --- Seleção do arquivo ISO ---
        caixa.append(Gtk.Label(label="📀 Arquivo ISO:", xalign=0))
        linha_iso = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.label_iso = Gtk.Label(label="Nenhum arquivo selecionado")
        self.label_iso.set_hexpand(True)
        self.label_iso.set_xalign(0)
        botao_escolher = Gtk.Button(label="📂 Selecionar ISO…")
        botao_escolher.add_css_class("botao-azul")
        botao_escolher.connect("clicked", self.ao_clicar_escolher_iso)
        linha_iso.append(self.label_iso)
        linha_iso.append(botao_escolher)
        caixa.append(linha_iso)

        # --- Seleção do pendrive ---
        caixa.append(Gtk.Label(label="🔌 Dispositivo de destino:", xalign=0))
        linha_dev = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.combo_dispositivos = Gtk.DropDown()
        self.combo_dispositivos.set_hexpand(True)
        self.combo_dispositivos.connect(
            "notify::selected", lambda w, p: self._atualizar_painel_propriedades()
        )
        botao_atualizar = Gtk.Button(label="🔄 Atualizar")
        botao_atualizar.add_css_class("botao-laranja")
        botao_atualizar.connect("clicked", lambda w: self.atualizar_dispositivos())
        linha_dev.append(self.combo_dispositivos)
        linha_dev.append(botao_atualizar)
        caixa.append(linha_dev)

        # --- Painel de propriedades do dispositivo (modelo, conexão, partições) ---
        self.caixa_propriedades = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.caixa_propriedades.add_css_class("caixa-status")
        self.label_propriedades = Gtk.Label(label="Selecione um dispositivo para ver detalhes.")
        self.label_propriedades.set_xalign(0)
        self.label_propriedades.set_wrap(True)
        self.caixa_propriedades.append(self.label_propriedades)
        caixa.append(self.caixa_propriedades)

        # --- Barra de progresso ---
        self.barra_progresso = Gtk.ProgressBar()
        self.barra_progresso.set_show_text(True)
        caixa.append(self.barra_progresso)

        # --- Status ---
        caixa_status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        caixa_status.add_css_class("caixa-status")
        self.label_status = Gtk.Label(label="✅ Pronto.", xalign=0)
        self.label_status.set_hexpand(True)
        caixa_status.append(self.label_status)
        caixa.append(caixa_status)

        # --- Linha de ações principais (Gravar / Cancelar) ---
        linha_acoes = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        linha_acoes.set_homogeneous(True)

        self.botao_gravar = Gtk.Button(label="🔥 Gravar ISO")
        self.botao_gravar.add_css_class("botao-verde")
        self.botao_gravar.connect("clicked", self.ao_clicar_gravar)
        linha_acoes.append(self.botao_gravar)

        self.botao_cancelar = Gtk.Button(label="🛑 Cancelar")
        self.botao_cancelar.add_css_class("botao-vermelho")
        self.botao_cancelar.set_sensitive(False)
        self.botao_cancelar.connect("clicked", self.ao_clicar_cancelar)
        linha_acoes.append(self.botao_cancelar)

        caixa.append(linha_acoes)

        # --- Botão fechar (sempre disponível) ---
        botao_fechar = Gtk.Button(label="🚪 Fechar")
        botao_fechar.add_css_class("botao-cinza")
        botao_fechar.connect("clicked", lambda w: self.close())
        caixa.append(botao_fechar)

        self._modelo_dispositivos = Gtk.StringList()
        self.combo_dispositivos.set_model(self._modelo_dispositivos)
        self._dispositivos_atuais = []

        self.atualizar_dispositivos()

        # Verifica periodicamente se um pendrive foi conectado/removido
        # depois que o app já estava aberto, sem precisar clicar em Atualizar.
        GLib.timeout_add_seconds(2, self._verificar_novos_dispositivos)

    def ao_clicar_sobre(self, acao, parametro):
        sobre = Gtk.AboutDialog()
        sobre.set_transient_for(self)
        sobre.set_modal(True)
        sobre.set_program_name("voidbr-iso-writer")
        sobre.set_version("1.0")
        sobre.set_logo_icon_name("media-optical-symbolic")
        sobre.set_comments(
            "💿 Gravador de imagens ISO em pendrives, feito com Python + GTK4.\n"
            "Desenvolvido para o VoidBR Linux 🐧"
        )
        sobre.set_website("https://voidbr.org")
        sobre.set_website_label("VoidBR")
        sobre.set_authors(["Vilmar Catafesta <vcatafesta@gmail.com>"])
        sobre.set_copyright("© 2026 Vilmar Catafesta — Licença livre, use e modifique à vontade")
        sobre.set_license_type(Gtk.License.MIT_X11)
        sobre.present()

    def _verificar_novos_dispositivos(self):
        # Não mexe na lista enquanto uma gravação está em andamento,
        # pra não trocar o combo debaixo do usuário no meio do processo.
        if self.botao_cancelar.get_sensitive():
            return True  # mantém o timeout ativo, só pula esta checagem

        dispositivos_novos = listar_dispositivos_usb()
        caminhos_novos = {d[0] for d in dispositivos_novos}
        caminhos_atuais = {d[0] for d in self._dispositivos_atuais}

        if caminhos_novos != caminhos_atuais:
            dispositivo_selecionado_antes = self._dispositivo_selecionado()
            self._dispositivos_atuais = dispositivos_novos
            self._modelo_dispositivos = Gtk.StringList()
            if not self._dispositivos_atuais:
                self._modelo_dispositivos.append("⚠️ Nenhum pendrive encontrado")
            else:
                for _, descricao, _tamanho, _propriedades in self._dispositivos_atuais:
                    self._modelo_dispositivos.append(descricao)
            self.combo_dispositivos.set_model(self._modelo_dispositivos)

            # Tenta manter o mesmo dispositivo selecionado, se ele ainda existir
            novo_indice = 0
            for i, (caminho, *_resto) in enumerate(self._dispositivos_atuais):
                if caminho == dispositivo_selecionado_antes:
                    novo_indice = i
                    break
            self.combo_dispositivos.set_selected(novo_indice)
            self._atualizar_painel_propriedades()

            if caminhos_novos - caminhos_atuais:
                self.label_status.set_text("🔌 Novo dispositivo detectado!")

        return True  # True mantém o GLib.timeout_add_seconds repetindo

    def atualizar_dispositivos(self):
        self._dispositivos_atuais = listar_dispositivos_usb()
        self._modelo_dispositivos = Gtk.StringList()
        if not self._dispositivos_atuais:
            self._modelo_dispositivos.append("⚠️ Nenhum pendrive encontrado")
        else:
            for _, descricao, _tamanho, _propriedades in self._dispositivos_atuais:
                self._modelo_dispositivos.append(descricao)
        self.combo_dispositivos.set_model(self._modelo_dispositivos)
        self.combo_dispositivos.set_selected(0)
        self._atualizar_painel_propriedades()

    def _atualizar_painel_propriedades(self):
        idx = self.combo_dispositivos.get_selected()
        if not (0 <= idx < len(self._dispositivos_atuais)):
            self.label_propriedades.set_text("Selecione um dispositivo para ver detalhes.")
            return

        nome, _descricao, _tamanho, propriedades = self._dispositivos_atuais[idx]
        linhas = [
            f"🏷️ Modelo: {propriedades['modelo']}",
            f"🔌 Conexão: {propriedades['transporte']}",
            f"💾 Capacidade: {propriedades['tamanho']}",
        ]
        if propriedades["particoes"]:
            linhas.append("📁 Partições:")
            for p in propriedades["particoes"]:
                linhas.append(f"   • {p}")
        else:
            linhas.append("📁 Partições: nenhuma detectada")

        self.label_propriedades.set_text("\n".join(linhas))

    def ao_clicar_escolher_iso(self, botao):
        dialogo = Gtk.FileChooserNative(
            title="Selecione a imagem ISO",
            transient_for=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        pasta_inicial = Gio.File.new_for_path(pasta_inicial_iso())
        dialogo.set_current_folder(pasta_inicial)
        filtro = Gtk.FileFilter()
        filtro.set_name("Imagens ISO")
        filtro.add_pattern("*.iso")
        dialogo.add_filter(filtro)
        dialogo.connect("response", self.ao_responder_escolher_iso)
        dialogo.show()

    def ao_responder_escolher_iso(self, dialogo, resposta):
        if resposta == Gtk.ResponseType.ACCEPT:
            arquivo = dialogo.get_file()
            if arquivo:
                self.caminho_iso = arquivo.get_path()
                self.label_iso.set_text(os.path.basename(self.caminho_iso))
        dialogo.destroy()

    def _dispositivo_selecionado(self):
        idx = self.combo_dispositivos.get_selected()
        if 0 <= idx < len(self._dispositivos_atuais):
            return self._dispositivos_atuais[idx][0]
        return None

    def _tamanho_dispositivo_selecionado(self):
        idx = self.combo_dispositivos.get_selected()
        if 0 <= idx < len(self._dispositivos_atuais):
            return self._dispositivos_atuais[idx][2]
        return 0

    def ao_clicar_gravar(self, botao):
        if not self.caminho_iso:
            self._mostrar_erro("Selecione um arquivo ISO antes de continuar.")
            return

        dispositivo = self._dispositivo_selecionado()
        if not dispositivo:
            self._mostrar_erro("Selecione um dispositivo de destino válido.")
            return

        tamanho_dispositivo = self._tamanho_dispositivo_selecionado()
        tamanho_iso = os.path.getsize(self.caminho_iso)

        aviso_extra = ""
        # Se o destino for muito maior que a ISO (ex: > 200 GB), pode ser HD externo
        if tamanho_dispositivo > 200 * 1024 ** 3:
            aviso_extra = (
                "\n\n⚠️ Esse dispositivo é bem grande para um pendrive comum "
                "— pode ser um HD/SSD externo. Confira se é mesmo o destino certo!"
            )
        elif tamanho_iso > tamanho_dispositivo > 0:
            aviso_extra = (
                "\n\n⚠️ O arquivo ISO parece ser MAIOR que o dispositivo selecionado. "
                "A gravação provavelmente vai falhar."
            )

        dialogo_confirmacao = Gtk.AlertDialog()
        dialogo_confirmacao.set_message("⚠️ Confirmar gravação")
        dialogo_confirmacao.set_detail(
            f"Isso APAGARÁ todos os dados em {dispositivo}.\n"
            f"Arquivo: {os.path.basename(self.caminho_iso)}\n\n"
            "Esta ação não pode ser desfeita. Deseja continuar?"
            f"{aviso_extra}"
        )
        dialogo_confirmacao.set_buttons(["❌ Cancelar", "🔥 Gravar"])
        dialogo_confirmacao.set_cancel_button(0)
        dialogo_confirmacao.set_default_button(0)
        dialogo_confirmacao.choose(self, None, self._ao_confirmar_gravacao, dispositivo)

    def ao_clicar_cancelar(self, botao):
        if self.processo and self.processo.poll() is None:
            try:
                subprocess.run(["pkexec", "kill", "-TERM", str(self.processo.pid)])
            except Exception:
                pass
            self.label_status.set_text("🛑 Gravação cancelada pelo usuário.")
            self.botao_cancelar.set_sensitive(False)
            self.botao_gravar.set_sensitive(True)

    def _ao_confirmar_gravacao(self, dialogo, resultado, dispositivo):
        try:
            escolha = dialogo.choose_finish(resultado)
        except GLib.Error:
            return
        if escolha == 1:
            self._iniciar_gravacao(dispositivo)

    def _mostrar_erro(self, mensagem):
        dialogo = Gtk.AlertDialog()
        dialogo.set_message("❌ Erro")
        dialogo.set_detail(mensagem)
        dialogo.show(self)

    def _iniciar_gravacao(self, dispositivo):
        self.botao_gravar.set_sensitive(False)
        self.botao_cancelar.set_sensitive(True)
        self.label_status.set_text("⏳ Gravando… não remova o pendrive.")
        self.barra_progresso.set_fraction(0.0)

        tamanho_iso = os.path.getsize(self.caminho_iso)

        thread = threading.Thread(
            target=self._executar_dd,
            args=(self.caminho_iso, dispositivo, tamanho_iso),
            daemon=True,
        )
        thread.start()

    def _executar_dd(self, origem, destino, tamanho_total):
        # Em vez de confiar no "status=progress" do dd (que atualiza a linha
        # com '\r' e formata os números conforme o locale — em pt_BR pode
        # sair "12.345.678 bytes" com pontos de milhar, quebrando o parsing),
        # fazemos como o chili-iso2usb original: copiamos em blocos fixos e
        # nós mesmos controlamos e relatamos o progresso, um bloco por vez.
        # Tudo dentro de UM ÚNICO pkexec, então a senha só é pedida uma vez.
        tamanho_bloco = 4 * 1024 * 1024  # 4 MiB
        num_blocos = max(1, (tamanho_total + tamanho_bloco - 1) // tamanho_bloco)

        script_bash = f"""
set -e
bs={tamanho_bloco}
total={tamanho_total}
blocos={num_blocos}
i=0
while [ "$i" -lt "$blocos" ]; do
    dd if='{origem}' of='{destino}' bs="$bs" count=1 skip="$i" seek="$i" conv=notrunc status=none 2>/dev/null
    i=$((i + 1))
    copiado=$((i * bs))
    if [ "$copiado" -gt "$total" ]; then
        copiado=$total
    fi
    echo "PROGRESSO:$copiado"
done
sync
echo "CONCLUIDO"
"""
        comando = ["pkexec", "bash", "-c", script_bash]
        try:
            self.processo = subprocess.Popen(
                comando,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
            )

            saida_erro = []
            concluido_com_sync = False

            for linha in self.processo.stdout:
                linha = linha.strip()
                if linha.startswith("PROGRESSO:"):
                    copiados = int(linha.split(":", 1)[1])
                    fracao = min(copiados / tamanho_total, 1.0) if tamanho_total else 0
                    GLib.idle_add(self.barra_progresso.set_fraction, fracao)
                    GLib.idle_add(
                        self.barra_progresso.set_text, f"{fracao * 100:.0f}%"
                    )
                elif linha == "CONCLUIDO":
                    concluido_com_sync = True

            codigo = self.processo.wait()
            if self.processo.stderr:
                saida_erro.append(self.processo.stderr.read())

            if codigo == 0 and concluido_com_sync:
                GLib.idle_add(self._ao_concluir_sucesso)
            else:
                GLib.idle_add(
                    self._ao_concluir_erro,
                    f"processo retornou código {codigo}. {' '.join(saida_erro)}",
                )
        except FileNotFoundError:
            GLib.idle_add(
                self._ao_concluir_erro,
                "Comando 'pkexec', 'bash' ou 'dd' não encontrado. Instale polkit e coreutils."
            )
        except Exception as e:
            GLib.idle_add(self._ao_concluir_erro, str(e))

    def _ao_concluir_sucesso(self):
        self.barra_progresso.set_fraction(1.0)
        self.label_status.set_text("✅ Gravação concluída com sucesso!")
        self.botao_gravar.set_sensitive(True)
        self.botao_cancelar.set_sensitive(False)

    def _ao_concluir_erro(self, mensagem):
        self.label_status.set_text(f"❌ Falha na gravação: {mensagem}")
        self.botao_gravar.set_sensitive(True)
        self.botao_cancelar.set_sensitive(False)


class AppISOWriter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="br.voidbr.isowriter")

    def do_activate(self):
        janela = JanelaISOWriter(self)
        janela.present()


if __name__ == "__main__":
    app = AppISOWriter()
    app.run(None)
