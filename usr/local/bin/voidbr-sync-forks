#!/usr/bin/env bash
set -euo pipefail

ORG="voidlinux-br"

green="$(printf '\033[1;32m')"
red="$(printf '\033[1;31m')"
yellow="$(printf '\033[1;33m')"
cyan="$(printf '\033[1;36m')"
bold="$(printf '\033[1m')"
reset="$(printf '\033[0m')"

msg() {
    printf "${cyan}==>${reset} ${bold}%s${reset}\n" "$*"
}

ok() {
    printf "${green}[OK]${reset} %s\n" "$*"
}

err() {
    printf "${red}[ERRO]${reset} %s\n" "$*"
}

warn() {
    printf "${yellow}[AVISO]${reset} %s\n" "$*"
}

repos=()
while IFS= read -r repo; do
    repos+=("$repo")
done < <(
    gh repo list "$ORG" \
        --fork \
        --limit 1000 \
        --json name \
        --jq '.[].name'
)

total="${#repos[@]}"
count=0
success=0
failed=0

msg "Sincronizando ${total} forks da organização '${ORG}'"
printf "\n"

for repo in "${repos[@]}"; do
    count=$((count + 1))

    printf "${cyan}[%2d/%2d]${reset} %-45s" "$count" "$total" "$repo"

    if gh repo sync "$ORG/$repo" >/dev/null 2>&1; then
        printf "${green}[OK]${reset}\n"
        success=$((success + 1))
    else
        printf "${red}[FALHOU]${reset}\n"
        failed=$((failed + 1))
    fi
done

printf "\n"
printf "${bold}──────────────────────────────────────────────────────────────${reset}\n"
printf " Organização : %s\n" "$ORG"
printf " Total       : %d\n" "$total"
printf " ${green}Sincronizados${reset} : %d\n" "$success"

if [ "$failed" -gt 0 ]; then
    printf " ${red}Falhas${reset}        : %d\n" "$failed"
else
    printf " ${green}Falhas${reset}        : 0\n"
fi

printf "${bold}──────────────────────────────────────────────────────────────${reset}\n"
